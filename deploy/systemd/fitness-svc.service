[Unit]
Description=Fitness Tracker service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=familyapps
WorkingDirectory=/opt/family-app-suite/fitness-svc
EnvironmentFile=/etc/family-app-suite/fitness-svc.env
ExecStart=/opt/family-app-suite/fitness-svc/fitness-svc
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
