[Unit]
Description=Finance Tracker service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=familyapps
WorkingDirectory=/opt/family-app-suite/finance-svc
EnvironmentFile=/etc/family-app-suite/finance-svc.env
ExecStart=/opt/family-app-suite/finance-svc/finance-svc
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
