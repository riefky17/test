# Copy to /etc/family-app-suite/<service>.env per service (finance-svc,
# geochat-svc, fitness-svc all read the same shape; geochat-svc is the
# only one that needs SOS_LOG_PATH).

# Shared Postgres instance, schema-separated per app.
DATABASE_URL=postgres://familyapps:CHANGE_ME@127.0.0.1:5432/familyapps?sslmode=disable

# Loopback only -- HAProxy is the only thing that talks to this port.
# finance-svc: 127.0.0.1:3001 / geochat-svc: 127.0.0.1:3002 / fitness-svc: 127.0.0.1:3003
LISTEN_ADDR=127.0.0.1:3001

# Session cookie shared across all 3 subdomains.
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true

# Built frontend copied here at deploy time (frontend/dist).
STATIC_DIR=/opt/family-app-suite/finance-svc/public

# geochat-svc only: independent append-only audit trail for every SOS
# trigger, written alongside the geochat.sos_events row. There is no
# third-party fallback (no Telegram/WhatsApp) -- SOS delivery is the
# live websocket broadcast to this same web messenger, nothing else.
SOS_LOG_PATH=/var/log/geochat/sos.log
